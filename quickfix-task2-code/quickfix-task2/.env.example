# Copy to .env on the server. .env must NEVER be committed to git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quickfix_db
DB_USER=quickfix_app
DB_PASS=change-me

# Firebase project Web API key - used by the API to verify ID tokens.
FIREBASE_WEB_API_KEY=change-me

# SMTP for booking confirmations
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@quickfix.co.za
SMTP_PASS=change-me
